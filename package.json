{
  "name": "cv-builder",
  "version": "1.0.0",
  "private": true,
  "description": "A CV builder that runs entirely in the browser. Write in plain text, preview on paper, export to PDF.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-lines.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm coverage && pnpm build && pnpm e2e",
    "e2e": "playwright test",
    "vrt:reference": "node scripts/vrt-reference.mjs",
    "vrt": "playwright test --project=vrt",
    "deploy": "pnpm build && pnpm dlx wrangler deploy"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.4.299",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bold": "^3.31.4",
    "@tiptap/extension-bullet-list": "^3.31.4",
    "@tiptap/extension-code": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-italic": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-list-item": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "packageManager": "pnpm@11.17.0"
}
